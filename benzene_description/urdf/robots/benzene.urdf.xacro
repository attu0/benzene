<?xml version="1.0"?>

<robot name="benzene" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="benzene"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>

  <xacro:property name="base_length" value="0.340"/>
  <xacro:property name="base_width"  value="0.240"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="base_mass"   value="5.0"/>
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width"  value="0.020"/>
  <xacro:property name="wheel_mass"   value="0.20"/>
  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_width"  value="0.020"/>
  <xacro:property name="caster_mass"   value="0.05"/>

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <xacro:macro name="default_inertial" params="mass">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="1e-3" ixy="0.0" ixz="0.0" iyy="1e-3" iyz="0.0" izz="1e-3" />
    </inertial>
  </xacro:macro>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 ${pi/2}"/>
      <geometry>
        <mesh
          filename="package://benzene_description/meshes/v3/visual/base_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${(1.0/12.0) * base_mass * (base_width*base_width + base_height*base_height)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1.0/12.0) * base_mass * (base_length*base_length + base_height*base_height)}"
        iyz="0.0"
        izz="${(1.0/12.0) * base_mass * (base_length*base_length + base_width*base_width)}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.0925 0.020" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://benzene_description/meshes/v3/visual/wheel_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius*wheel_radius}"/>
      </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.0925 0.020" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
        <geometry>
          <mesh filename="package://benzene_description/meshes/v3/visual/wheel_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="-${pi/2} 0 0"/>
        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1.0/12.0) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0.0"
          izz="${0.5 * wheel_mass * wheel_radius*wheel_radius}"/>
      </inertial>
  </link>


  <joint name="back_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="back_caster_wheel"/>
    <origin xyz="-0.13 0 0" rpy="0 0 0"/>
  </joint>

  <link name="back_caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://benzene_description/meshes/v3/visual/caster_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"
        ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"
        iyz="0.0"
        izz="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"/>
    </inertial>
  </link>


  <joint name="front_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster_wheel"/>
    <origin xyz="0.13 0 0" rpy="0 0 0"/>
  </joint>

  <link name="front_caster_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://benzene_description/meshes/v3/visual/caster_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"
        ixy="0.0" ixz="0.0"
        iyy="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"
        iyz="0.0"
        izz="${(2.0/5.0) * caster_mass * caster_radius * caster_radius}"/>
    </inertial>
  </link>

  <gazebo reference="$(arg prefix)front_caster_wheel">

    <material>
      <ambient>0 0 0 1</ambient>
      <diffuse>0 0 0 1</diffuse>
      <specular>0 0 0 1</specular>
    </material>

    <mu1>0.0001</mu1>
    <mu2>0.0001</mu2>

  </gazebo>

  <!-- ===========================================================
       SENSOR MACROS (lidar / camera / imu) — each brings its own
       link, fixed joint, and <gazebo><sensor> plugin block.
       Adjust these include paths to wherever the files actually
       live in benzene_description (e.g. urdf/sensors/...).
       =========================================================== -->
  <xacro:include filename="$(find benzene_description)/urdf/sensors/lidar.urdf.xacro"/>
  <xacro:include filename="$(find benzene_description)/urdf/sensors/simple_camera.urdf.xacro"/>
  <xacro:include filename="$(find benzene_description)/urdf/sensors/imu.urdf.xacro"/>

  <xacro:lidar_sensor
    prefix="$(arg prefix)"
    parent="base_link"
    frame_id="laser_frame"
    xyz_offset="0 0 0.08"
    rpy_offset="0 0 0"
    mesh_xyz_offset="0 0 -0.01"
    mesh_rpy_offset="0 0 0"
    topic_name="scan"/>

  <xacro:imu_sensor
    prefix="$(arg prefix)"
    parent="base_link"
    frame_id="imu"
    xyz_offset="0.15 0.06 0"
    rpy_offset="0 0 0"
    update_rate="15.0"
    topic_name="imu/data"/>

  <xacro:simple_camera
    camera_name="camera"
    parent="base_link"
    xyz_offset="0.17 0 0.03"
    rpy_offset="0 0 0"
    image_width="640"
    image_height="480"
    horizontal_fov="1.089"
    update_rate="30"
    topic="camera/image_raw"
    camera_info_topic="camera/camera_info"/>

  <joint name="uss_joint" type="fixed">
    <parent link="base_link"/>
    <child link="uss_link"/>
    <origin xyz="0.175 0 0.055" rpy="0 0 0"/>
  </joint>

  <link name="uss_link"/>


  <xacro:include filename="$(find benzene_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro"/>

  <xacro:load_gazebo_sim_ros2_control_plugin robot_name="benzene" use_gazebo="$(arg use_gazebo)"/>

  <xacro:include filename="$(find benzene_description)/urdf/control/velocity_control_plugin.urdf.xacro"/>

  <xacro:load_velocity_control_plugin use_gazebo="$(arg use_gazebo)"/>

  <xacro:include filename="$(find benzene_description)/urdf/control/benzene_control.urdf.xacro"/>

  <xacro:benzene_ros2_control prefix="$(arg prefix)" use_gazebo="$(arg use_gazebo)"/>

  <gazebo reference="$(arg prefix)back_caster_wheel">

    <material>
      <ambient>0 0 0 1</ambient>
      <diffuse>0 0 0 1</diffuse>
      <specular>0 0 0 1</specular>
    </material>

    <mu1>0.0001</mu1>
    <mu2>0.0001</mu2>

  </gazebo>

</robot>