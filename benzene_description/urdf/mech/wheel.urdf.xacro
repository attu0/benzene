<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- =========================================================
         WHEEL PARAMETERS
         ========================================================= -->

    <!-- Wheel physical dimensions -->
    <xacro:property name="wheel_radius" value="0.035"/>
    <xacro:property name="wheel_width" value="0.020"/>

    <!-- Distance between left and right wheel centers -->
    <xacro:property name="wheel_separation" value="0.180"/>

    <!-- Wheel position relative to base_link -->
    <xacro:property name="wheel_x_offset" value="0.0"/>
    <xacro:property name="wheel_z_offset" value="0.020"/>

    <!-- Wheel mass -->
    <xacro:property name="wheel_mass" value="0.2"/>


    <!-- =========================================================
         WHEEL MACRO
         ========================================================= -->

    <xacro:macro name="wheel"
                 params="prefix side x_reflect y_reflect">

        <!-- =====================================================
             LEFT / RIGHT WHEEL LINK
             ===================================================== -->

        <link name="${prefix}${side}_wheel_link">

            <!-- =================================================
                 VISUAL
                 ================================================= -->

            <visual>

                <origin
                    xyz="0 0 0"
                    rpy="${-y_reflect * pi/2} 0 0"/>

                <geometry>

                    <mesh
                        filename="file://$(find benzene_description)/meshes/benzene/visual/${side}_wheel.stl"
                        scale="0.001 0.001 0.001"/>

                </geometry>

                <material name="blue">

                    <color rgba="0 0 1 1"/>

                </material>

            </visual>


            <!-- =================================================
                 COLLISION
                 ================================================= -->

            <collision>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <geometry>

                    <cylinder
                        radius="${wheel_radius}"
                        length="${wheel_width}"/>

                </geometry>

            </collision>


            <!-- =================================================
                 INERTIAL
                 ================================================= -->

            <inertial>

                <origin
                    xyz="0 0 0"
                    rpy="0 0 0"/>

                <mass value="${wheel_mass}"/>

                <inertia
                    ixx="${(wheel_mass / 12.0) * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"
                    ixy="0.0"
                    ixz="0.0"
                    iyy="${(wheel_mass / 2.0) * wheel_radius * wheel_radius}"
                    iyz="0.0"
                    izz="${(wheel_mass / 12.0) * (3.0 * wheel_radius * wheel_radius + wheel_width * wheel_width)}"/>

            </inertial>

        </link>


        <!-- =====================================================
             LEFT / RIGHT WHEEL JOINT
             ===================================================== -->

        <joint
            name="${prefix}${side}_wheel_joint"
            type="continuous">

            <parent link="${prefix}base_link"/>

            <child link="${prefix}${side}_wheel_link"/>

            <!--
                LEFT:
                    X = 0
                    Y = +0.09
                    Z = +0.02

                RIGHT:
                    X = 0
                    Y = -0.09
                    Z = +0.02
            -->

            <origin
                xyz="${x_reflect * wheel_x_offset}
                      ${y_reflect * (wheel_separation / 2.0)}
                      ${wheel_z_offset}"
                rpy="0 0 0"/>

            <!-- Same wheel rotation axis as the original model -->
            <axis xyz="0 1 0"/>

        </joint>


        <!-- =====================================================
             GAZEBO PARAMETERS
             ===================================================== -->

        <gazebo reference="${prefix}${side}_wheel_link">

            <surface>

                <friction>

                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>

                </friction>

            </surface>

            <visual>

                <material>

                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                    <specular>0 0 1 1</specular>
                    <emissive>0 0 0 0</emissive>

                </material>

            </visual>

        </gazebo>

    </xacro:macro>

</robot>