<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="benzene_ros2_control" params="prefix use_gazebo">
        <ros2_control name="RobotSystem" type="system">
            <hardware>
                <xacro:if value="${use_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="${use_gazebo}">
                    <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
                    <param name="left_wheel_name">${prefix}left_wheel_joint</param>
                    <param name="right_wheel_name">${prefix}right_wheel_joint</param>
                    <param name="loop_rate">30</param>
                    <param name="device">/dev/ttyUSB0</param>
                    <param name="baud_rate">57600</param>
                    <param name="timeout_ms">1000</param>
                    <param name="enc_counts_per_rev">1420</param>
                </xacro:unless>
            </hardware>

            <joint name="${prefix}left_wheel_joint">
                <command_interface name="velocity" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>

            <joint name="${prefix}right_wheel_joint">
                <command_interface name="velocity" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </ros2_control>
    </xacro:macro>

</robot>