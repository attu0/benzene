    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.65 0.65 0.65 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Compact rounded race circuit -->
    <model name="race_track">
